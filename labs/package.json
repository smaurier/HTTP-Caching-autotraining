{
  "name": "http-caching-labs",
  "version": "1.0.0",
  "private": true,
  "description": "Oracles exécutables des labs HTTP Caching (règle : un lab = un geste métier complet). Le cache est prouvé par un compteur d'appels coûteux mesuré, pas par la présence d'en-têtes.",
  "type": "module",
  "scripts": {
    "lab:01": "vitest run --root lab-01-strategie-de-cache",
    "solution:01": "vitest run --root lab-01-strategie-de-cache --config vitest.solution.config.ts",
    "lab:02": "vitest run --root lab-02-pwa-offline-first",
    "solution:02": "vitest run --root lab-02-pwa-offline-first --config vitest.solution.config.ts",
    "lab:03": "vitest run --root lab-03-cache-stale-en-prod",
    "solution:03": "vitest run --root lab-03-cache-stale-en-prod --config vitest.solution.config.ts",
    "lab:04": "vitest run --root lab-04-ajouter-le-push",
    "solution:04": "vitest run --root lab-04-ajouter-le-push --config vitest.solution.config.ts"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "5.0.1"
  }
}
